#!/bin/sh /etc/rc.common


START=96
STOP=10

USE_PROCD=1

BASESTATION_BIN=/usr/bin/basestation.py

# 启动基站服务
start_service() {
	# 业务代码尚未就绪时不启动, 避免 procd 反复拉起不存在的程序
	[ -x "$BASESTATION_BIN" ] || {
		logger -t "BASESTATION" "<$FUNCNAME> ${BASESTATION_BIN} not found, skip"
		return 0
	}

	logger -t "BASESTATION" "<$FUNCNAME> start ${BASESTATION_BIN}"

	procd_open_instance
	procd_set_param command "$BASESTATION_BIN"
	procd_set_param respawn 3600 5 5				# 意外退出时由 procd 重新拉起: 1 小时内、5 秒内重启超过 5 次则放弃, 避免反复刷日志
	procd_set_param stdout 1						# 脚本通过 stdout 输出日志, 交给 procd 收进 logd(logread 查看)
	procd_set_param stderr 1
	procd_close_instance
}

# 停止基站服务(实例由 procd 结束)
stop_service() {
	logger -t "BASESTATION" "<$FUNCNAME> stop"
}

# 注册 procd 重载触发器: /etc/config/basestation 变更并提交(uci commit)后自动触发本脚本的 reload
service_triggers() {
	procd_add_reload_trigger basestation
}

# UCI 配置变更触发的重载动作: 直接重启服务, 使新配置生效
reload_service() {
	restart "$@"
}
