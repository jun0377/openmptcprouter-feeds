# See /LICENSE for more information.
#

START=95
STOP=10

USE_PROCD=1

LCD_BIN=/usr/bin/lcd.py
LCD_UPDATE=/usr/bin/lcd-update.py
LCD_UART=/dev/ttyAMA4
LOG_FILE=/var/log/lcd/lcd.log

# 日志写入文件, 不经过 logd; 1MB 轮转由 Python 侧的 logger 统一处理
log_msg() {
	mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null
	printf '[%s] [LCD] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE" 2>/dev/null
}

# 查找待升级的 tft 文件: 只认 /root/*.tft, 忽略上传中的 .part 与已重命名的历史文件
find_upgrade_file() {
	ls -1t /root/*.tft 2>/dev/null | head -n 1
}

# 升级前停掉可能占用屏幕串口的 lcd.py, 最多等 2 秒
stop_lcd_process() {
	local pid i=0

	for pid in $(pgrep -f "$LCD_BIN" 2>/dev/null); do
		log_msg "stop ${LCD_BIN} (pid ${pid}) before upgrade"
		kill "$pid" 2>/dev/null
	done

	while [ "$i" -lt 2 ] && pgrep -f "$LCD_BIN" >/dev/null 2>&1; do
		sleep 1
		i=$((i + 1))
	done
}

# 启动 LCD 显示服务
start_service() {
	local upgrade_file

	upgrade_file="$(find_upgrade_file)"

	# 有升级文件时: 先释放串口, 再把升级程序交给 procd 异步执行
	# 升级结束(成功或失败)后由 lcd-update.py exec 成 lcd.py, 不阻塞开机流程
	if [ -n "$upgrade_file" ] && [ -x "$LCD_UPDATE" ]; then
		log_msg "<$FUNCNAME> upgrade file: ${upgrade_file}"
		stop_lcd_process

		procd_open_instance upgrade
		procd_set_param command "$LCD_UPDATE" --file "$upgrade_file" --dev "$LCD_UART"
		procd_set_param respawn 3600 5 5		# 意外退出时由 procd 重新拉起, 避免升级程序异常后没有 UI
		procd_close_instance
		return 0
	elif [ -n "$upgrade_file" ]; then
		log_msg "<$FUNCNAME> ${LCD_UPDATE} not executable, skip upgrade"
	fi

	log_msg "<$FUNCNAME> start ${LCD_BIN}"

	procd_open_instance
	procd_set_param command "$LCD_BIN"
	procd_set_param respawn 3600 5 5			# 意外退出时由 procd 重新拉起
	procd_close_instance
}

# 停止 LCD 显示服务(实例由 procd 结束)
stop_service() {
	log_msg "<$FUNCNAME> stop"
}
