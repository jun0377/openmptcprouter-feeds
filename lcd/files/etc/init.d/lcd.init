START=95
STOP=10

USE_PROCD=1

LCD_BIN=/usr/bin/lcd.py

# 启动 LCD 显示服务
start_service() {
	logger -t "LCD" "<$FUNCNAME> start ${LCD_BIN}"

	procd_open_instance
	procd_set_param command "$LCD_BIN"
	procd_set_param respawn 3600 5 5				# 意外退出时由 procd 重新拉起: 1 小时内、5 秒内重启超过 5 次则放弃, 避免反复刷日志
	procd_set_param stdout 1						# 脚本通过 stdout 输出日志, 交给 procd 收进 logd(logread 查看)
	procd_set_param stderr 1
	procd_close_instance
}

# 停止 LCD 显示服务(实例由 procd 结束)
stop_service() {
	logger -t "LCD" "<$FUNCNAME> stop"
}
