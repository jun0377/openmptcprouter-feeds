START=99

USE_PROCD=1

EXTRA_COMMANDS="backup_send backup_get backup_list get_openvpn_key token set_vpn_ip"

. /usr/lib/unbound/iptools.sh

# 新的nftables框架
if [ -e /usr/sbin/iptables-nft ]; then
	IPTABLES="/usr/sbin/iptables-nft"
	IPTABLESRESTORE="/usr/sbin/iptables-nft-restore"
	IPTABLESSAVE="/usr/sbin/iptables-nft-save"
	IP6TABLES="/usr/sbin/ip6tables-nft"
	IP6TABLESRESTORE="/usr/sbin/ip6tables-nft-restore"
	IP6TABLESSAVE="/usr/sbin/ip6tables-nft-save"
# 传统的iptables
else
	IPTABLES="/usr/sbin/iptables"
	IPTABLESRESTORE="/usr/sbin/iptables-restore"
	IPTABLESSAVE="/usr/sbin/iptables-save"
	IP6TABLES="/usr/sbin/ip6tables"
	IP6TABLESRESTORE="/usr/sbin/ip6tables-restore"
	IP6TABLESSAVE="/usr/sbin/ip6tables-save"
fi

# 解析JSON格式的数据中的result字段
_parse_result() {
	result=$("echo $1 | jsonfilter -q -e '@.result'")
	echo $result
}

# VPS服务器的认证登录
_login() {
	local username password auth
	
	# 从配置文件/etc/config/openmptcprouter中获取用户名、密码、端口
	username="$(uci -q get openmptcprouter.${servername}.username)"		# uci get openmptcprouter.vps.username
	password="$(uci -q get openmptcprouter.${servername}.password)"		# uci get openmptcprouter.vps.password
	serverport="$(uci -q get openmptcprouter.${servername}.port)"		# uci get openmptcprouter.vps.port

	# 自动获取服务器密码，自动登录
	local serverip="$(uci -q get openmptcprouter.vps.ip)"
	# 检查服务器IP地址格式是否正确
	[ "$(valid_subnet_any "$serverip")" != "ok" ] && logger -t "OMR" "<$FUNCNAME> Unkonwn server ip: ${serverip}! " && return
	# 序列号, 以CPU序列号作为整机序列号
	[ "${serial}" == "" ] && serial=$(cat /proc/cpuinfo | grep Serial | awk '{print $3}') && logger -t "OMR" "serial: ${serial}"
	# curl -s -k -X POST https://36.133.201.26:65500/passwd?serial=0123456789
	new_password="$(curl -s -k -X POST https://${serverip}:${serverport}/passwd?serial=${serial} | jsonfilter -e '@.password')"
	# 遍历默认路由接口,触发系统路由选择不同出口网卡,这段逻辑存疑! 明明没有切换网卡的逻辑呀? 一直使用的都是默认网关对应的网口...
	if [ -z "$new_password" ]; then
		for intf in $(multipath 2>/dev/null | awk '/default/ { print $1 }'); do
			new_password="$(curl -s -k -X POST https://${serverip}:${serverport}/passwd?serial=${serial})"
			[ -n "$new_password" ] && break
		done
	fi

	# 无法获取服务器访问密码,直接return
	[ ! -n "$new_password" ] && logger -t "OMR" "<$FUNCNAME> Get server ${serverip}:${serverport} password error! " && return
	# 更新uci配置文件中的password
	if [ "$new_password" != "$password" ]; then
		logger -t "OMR" "<$FUNCNAME> new_password: ${new_password}"
		password=${new_password}
		logger -t "OMR" "<$FUNCNAME> uci -q set openmptcprouter.${servername}.password=${password}"
		uci -q set openmptcprouter.${servername}.password=${password}
	fi

	# 获取身份认证token
	if [ -z "$token" ]; then

		# 代码块中的函数, 从服务器获取token
		login_on_server() {
			[ -n "$token" ] && return
			server=$1
			
			# submodules/feeds/6.6/packages/net/unbound/files/iptools.sh -> valid_subnet6()
			valid_ip6=$(valid_subnet6 $server)
			# IPv6
			if [ "$valid_ip6" = "ok" ]; then
				auth=`curl --max-time 10 -s -k -H "accept: application/json" -H "Content-Type: application/x-www-form-urlencoded" -X POST -d 'username='$username'&password='$password https://[$server]:$serverport/token`
			# IPv4
			else
				auth=`curl --max-time 10 -s -k -H "accept: application/json" -H "Content-Type: application/x-www-form-urlencoded" -X POST -d 'username='$username'&password='$password https://$server:$serverport/token`
			fi

			# auth为空，认证失败,使用其他接口重新尝试
			if [ -z "$auth" ]; then
				for intf in $(multipath 2>/dev/null | awk '/default/ { print $1 }'); do
					if [ "$valid_ip6" = "ok" ]; then
						auth=`curl --max-time 10 -s -k --interface $intf -H "accept: application/json" -H "Content-Type: application/x-www-form-urlencoded" -X POST -d 'username='$username'&password='$password https://[$server]:$serverport/token`
					else
						auth=`curl --max-time 10 -s -k --interface $intf -H "accept: application/json" -H "Content-Type: application/x-www-form-urlencoded" -X POST -d 'username='$username'&password='$password https://$server:$serverport/token`
					fi
					[ -n "$auth" ] && break
				done
			fi

			# 认证成功，解析获取token字段，保存到配置文件/etc/config/openmptcprouter中
			[ -n "$auth" ] && {
				token="$(echo "$auth" | jsonfilter -q -e '@.access_token')"
				uci -q set openmptcprouter.${servername}.token="$token"
			}
		}

		# 从文件/etc/config/openmptcprouter中加载配置到环境变量
		config_load openmptcprouter
		# 遍历所有的VPS服务器, 对/etc/config/openmptcprouter中的vps section中的list ip中的每个ip都执行login_on_server
		config_list_foreach ${servername} ip login_on_server
	fi
}

# VPS服务器的ping连通性状态检查
_ping_server() {
	server="$1"
	# 发送3个ICMP回显请求包,总超时时间为3秒,设置ICMP包的TOS字段为184,标记ping包为高优先级
	ret=$(ping -c 3 -w 3 -Q 184 $server 2>&1) && echo "$ret" | grep -sq "bytes from" && return
	false
}

# 发起http GET请求，获取JSON格式的响应数据
_get_json() {
	local route result
	# 请求的API URL
	route=$1
	# 没有token,需要先登录认证获取token
	[ -z "$token" ] && _login
	# 发起http请求，获取JSON格式的响应数据
	[ -n "$token" ] && {
		#resolve="$(resolveip -t 5 $server)"
		# http请求
		valid_ip6=$(valid_subnet6 $server)
		if [ "$valid_ip6" = "ok" ]; then
			logger -t "OMR" "<$FUNCNAME> curl https://[$server]:$serverport/$route"
			result=`curl --max-time 10 -s -k -H "accept: application/json" -H "Authorization: Bearer $token" https://[$server]:$serverport/$route`
		else
			logger -t "OMR" "<$FUNCNAME> curl https://$server:$serverport/$route"
			result=`curl --max-time 10 -s -k -H "accept: application/json" -H "Authorization: Bearer $token" https://$server:$serverport/$route`
		fi
		# 获取http响应失败，使用其它接口重试
		if [ -z "$result" ]; then
			for intf in $(multipath 2>/dev/null | awk '/default/ { print $1 }'); do
				if [ "$valid_ip6" = "ok" ]; then
					result=`curl --max-time 10 -s -k --interface $intf -H "accept: application/json" -H "Authorization: Bearer $token" https://[$server]:$serverport/$route`
				else
					result=`curl --max-time 10 -s -k --interface $intf -H "accept: application/json" -H "Authorization: Bearer $token" https://$server:$serverport/$route`
				fi
				[ -n "$result" ] && break
			done
		fi
		# 获取http响应失败
		if [ "$(echo $result | grep 'Could not validate credentials')" ]; then
			result=''
		fi
		# 获取http响应成功
		echo $result
	} || {
		echo ''
	}
}

# 设置JSON格式的请求体，并发起http POST请求
_set_json() {
	local route result settings
	# 请求URL
	route=$1
	settings="$2"
	# 没有token,需要先登录认证获取token
	[ -z "$token" ] && _login
	[ -n "$token" ] && {
		#resolve="$(resolveip -t 5 $server)"
		valid_ip6=$(valid_subnet6 $server)
		if [ "$valid_ip6" = "ok" ]; then
			logger -t "OMR" "curl post https://[$server]:$serverport/$route ${settings}"
			result=`curl --max-time 10 -s -k -H "Authorization: Bearer $token" -H "Content-Type: application/json" -X POST -d "$settings" https://[$server]:$serverport/$route`
		else
			logger -t "OMR" "curl post https://$server:$serverport/$route ${settings}"
			result=`curl --max-time 10 -s -k -H "Authorization: Bearer $token" -H "Content-Type: application/json" -X POST -d "$settings" https://$server:$serverport/$route`
		fi
		if [ -z "$result" ]; then
			for intf in $(multipath 2>/dev/null | awk '/default/ { print $1 }'); do
				if [ "$valid_ip6" = "ok" ]; then
					logger -t "OMR" "curl post https://[$server]:$serverport/$route ${settings}"
					result=`curl --max-time 10 -s -k --interface $intf -H "Authorization: Bearer $token" -H "Content-Type: application/json" -X POST -d "$settings" https://[$server]:$serverport/$route`
				else
					logger -t "OMR" "curl post https://$server:$serverport/$route ${settings}"
					result=`curl --max-time 10 -s -k --interface $intf -H "Authorization: Bearer $token" -H "Content-Type: application/json" -X POST -d "$settings" https://$server:$serverport/$route`
				fi
				[ -n "$result" ] && break
			done
		fi
		if [ "$(echo $result | grep 'Could not validate credentials')" ]; then
			result=''
		fi
		echo $result
	} || {
		echo ''
	}
}

# 当你在路由器上更新了 OpenVPN 端口或加密算法，本地对比不一致时， _set_openvpn_vps 会把这些设置同步到 VPS
# 当 VPS 返回的客户端密钥与本地不一致时， _set_openvpn_vps 会打 get_config 标记。随后通过显式调用 get_openvpn_key <servername> ，从 VPS 拉取并写入客户端密钥/证书/CA 文件
_set_openvpn_vps() {

	local enabled="$(uci -q get openvpn.omr.enabled)"
	
	# openvpn 未启用, 则启用之
	[ "$enabled" != "1" ] && { 
		logger -t "OMR" "<$FUNCNAME> OpenVPN disabled! re-enable now..."
		uci -q set openvpn.omr.enabled=1 && uci commit openvpn
		# return
	}

	[ -n "$(uci -q get openvpn.omr2)" ] && uci delete openvpn.omr2
	[ -n "$(uci -q get openvpn.omr3)" ] && uci delete openvpn.omr3
	[ -n "$(uci -q get openvpn.omr4)" ] && uci delete openvpn.omr4
	[ -n "$(uci -q changes openvpn)" ] && uci commit openvpn

	local port="$(uci -q get openvpn.omr.port)"						# 服务器端口 65301
	local cipher="$(uci -q get openvpn.omr.cipher)"					# 加密算法
	local key="$(base64 /etc/luci-uploads/client.key | tr -d "\n")"	# 客户端秘钥

	# 发起http请求，根据序列号从VPS检索对应的OpenVPN配置
	[ -z "$vps_config" ] && vps_config=$(_get_json "config?serial=${serial}")
	[ -z "$vps_config" ] && logger -t "OMR" "<$FUNCNAME> vps_config is empty! return now..." && return
	local current_key="$(echo "$vps_config" | jsonfilter -q -e '@.openvpn.client_key')"
	local current_port="$(echo "$vps_config" | jsonfilter -q -e '@.openvpn.port')"
	local current_cipher="$(echo "$vps_config" | jsonfilter -q -e '@.openvpn.cipher')"

	# 表示更新了OpenVPN的秘钥,提示本地需要拉取最新客户端配置
	if [ "$current_key" != "$key" ]; then
		logger -t "OMR" "<$FUNCNAME> OpenVPN key changed"
		uci -q set openmptcprouter.${servername}.get_config="1"
	fi

	logger -t "OMR" "<$FUNCNAME> port:${port}"
	logger -t "OMR" "<$FUNCNAME> cipher:${cipher}"
	# logger -t "OMR" "<$FUNCNAME> key:${key}"

	# 更新了OpenVPN的端口或加密算法
	if [ "$current_port" != "$port" ] || [ "$current_cipher" != "$cipher" ]; then
		local settings='{"port": '$port', "cipher": "'$cipher'"}'
		echo $(_set_json "openvpn" "$settings")
	else
		echo 1
	fi
}

# 外部调用，从VPN获取OpenVPN的密钥，并重启OpenVPN服务
get_openvpn_key() {
	servername=$2
	[ -z "$vps_config" ] && vps_config=$(_get_json "config?serial=${serial}")
	[ -z "$vps_config" ] && return
	openvpn_client_key="$(echo "$vps_config" | jsonfilter -q -e '@.openvpn.client_key')"
	[ -n "$openvpn_client_key" ] && {
		echo $openvpn_client_key | base64 -d > /etc/luci-uploads/client.key
	}
	openvpn_client_crt="$(echo "$vps_config" | jsonfilter -q -e '@.openvpn.client_crt')"
	[ -n "$openvpn_client_crt" ] && {
		echo $openvpn_client_crt | base64 -d > /etc/luci-uploads/client.crt
	}
	openvpn_client_ca="$(echo "$vps_config" | jsonfilter -q -e '@.openvpn.client_ca')"
	[ -n "$openvpn_client_ca" ] && {
		echo $openvpn_client_ca | base64 -d > /etc/luci-uploads/ca.crt
	}
	[ -n "$openvpn_client_key" ] && [ -n "$openvpn_client_crt" ] && [ -n "$openvpn_client_ca" ] && {
		[ "$(uci -q get openvpn.omr.enabled)" ] && /etc/init.d/openvpn restart
	}
}

# 从VPS获取配置，同步到本地
_get_vps_config() {

	# 首先获取VPS配置
	# 如果配置为空则返回
	# 然后检查配置的最后修改时间，如果VPS配置比本地新，则调用 _set_config_from_vps 更新本地配置
	[ -z "$vps_config" ] && vps_config=$(_get_json "config?serial=${serial}")
	[ -z "$vps_config" ] && return
	vps_lastchange="$(echo "$vps_config" | jsonfilter -q -e '@.vps.lastchange')"
	if [ -n "$(uci -q get openmptcprouter.${servername}.lastchange)" ] && [ -n "$vps_lastchange" ] && [ "$vps_lastchange" -gt "$(uci -q get openmptcprouter.${servername}.lastchange)" ]; then
		_set_config_from_vps
	fi

	# VPS系统信息同步: 内核版本、机器类型和OpenMPTCRouter版本信息
	vpsinternet="$(echo "$vps_config" | jsonfilter -q -e '@.network.internet')"
	if [ "$vpsinternet" = "false" ] && [ "$(uci -q get openmptcprouter.settings.external_check)" != "0" ]; then
		uci -q batch <<-EOF >/dev/null
			set openmptcprouter.settings.external_check='0'
			commit openmptcprouter
		EOF
	fi

	vps_kernel="$(echo "$vps_config" | jsonfilter -q -e '@.vps.kernel')"
	vps_machine="$(echo "$vps_config" | jsonfilter -q -e '@.vps.machine')"
	vps_omr_version="$(echo "$vps_config" | jsonfilter -q -e '@.vps.omr_version')"
	uci -q batch <<-EOF >/dev/null
		set openmptcprouter.${servername}.kernel=$vps_kernel
		set openmptcprouter.${servername}.machine=$vps_machine
		set openmptcprouter.${servername}.omr_version=$vps_omr_version
	EOF

	# VPN配置同步
	vpn="$(uci -q get openmptcprouter.settings.vpn)"

	# 解析和处理VPS的IP地址，允许以域名方式指定服务器IP
	vpsip="$(uci -q get openmptcprouter.${servername}.ip | awk '{print $1}')"
	ipresolve="$(resolveip -t 5 -4 $vpsip | head -n 1)"
	if [ -n "$ipresolve" ]; then
		vpsip="$ipresolve"
	else
		ip6resolve="$(resolveip -t 5 -6 $vpsip | head -n 1)"
		[ -n "$ip6resolve" ] && vpsip="$ip6resolve"
	fi

	# openvpn配置
	if [ -n "$(uci -q get openvpn.omr)" ] && [ "$(uci -q get openvpn.omr.remote)" != "127.0.0.1" ] && [ -z "$(uci -q get openvpn.omr.remote | grep $vpsip)" ] && [ "$(uci -q get openmptcprouter.settings.ha)" != "1" ]; then
		uci -q batch <<-EOF >/dev/null
			delete openvpn.omr.remote
			add_list openvpn.omr.remote="$vpsip"
			commit openvpn
		EOF
		if [ "$(uci -q get openvpn.omr.enabled)" = "1" ]; then
			logger -t "OMR" "Restart OpenVPN..."
			/etc/init.d/openvpn restart
		fi
	fi
}

# 从VPS同步端口重定向配置
_set_redirect_ports_from_vps() {

	logger -t "OMR" "<$FUNCNAME>..."

	redirect_ports=$1
	[ -z "$vps_config" ] && vps_config=$(_get_json "config?serial=${serial}")
	[ -z "$vps_config" ] && return
	redirect_ports_current="$(echo "$vps_config" | jsonfilter -q -e '@.shorewall.redirect_ports')"
	[ "$redirect_ports" = "1" ] && redirect_ports_request="enable"
	[ "$redirect_ports" = "0" ] && redirect_ports_request="disable"

	logger -t "OMR" "<$FUNCNAME> redirect_ports_request=${redirect_ports_request}"
	logger -t "OMR" "<$FUNCNAME> redirect_ports=${redirect_ports_current}"

	if [ "$redirect_ports_request" != "$redirect_ports_current" ]; then
		settings='{"redirect_ports": "'$redirect_ports_request'"}'
		echo $(_set_json "shorewall" "$settings")
	else
		echo 1
	fi

}

# 和VPS同步MPTCP配置
_set_mptcp_vps() {

	logger -t "OMR" "<$FUNCNAME>..."

	local settings
	[ -z "$vps_config" ] && vps_config=$(_get_json "config?serial=${serial}")
	[ -z "$vps_config" ] && logger -t "OMR" "<$FUNCNAME> vps_config is empty! return now..." && return
	mptcp_enabled_current="$(echo "$vps_config" | jsonfilter -q -e '@.mptcp.enabled')"
	checksum_current="$(echo "$vps_config" | jsonfilter -q -e '@.mptcp.checksum')"
	path_manager_current="$(echo "$vps_config" | jsonfilter -q -e '@.mptcp.path_manager')"
	scheduler_current="$(echo "$vps_config" | jsonfilter -q -e '@.mptcp.scheduler')"
	syn_retries_current="$(echo "$vps_config" | jsonfilter -q -e '@.mptcp.syn_retries')"
	congestion_control_current="$(echo "$vps_config" | jsonfilter -q -e '@.network.congestion_control')"
	mptcp_version_current="$(echo "$vps_config" | jsonfilter -q -e '@.mptcp.version')"
	mptcp_enabled="$(uci -q get network.globals.multipath)"
	if [ "$mptcp_enabled" = "disable" ]; then
		mptcp_enabled="0"
	else
		mptcp_enabled="1"
	fi
	checksum="$(uci -q get network.globals.mptcp_checksum)"
	path_manager="$(uci -q get network.globals.mptcp_path_manager)"
	scheduler="$(uci -q get network.globals.mptcp_scheduler)"
	syn_retries="$(uci -q get network.globals.mptcp_syn_retries)"
	congestion="$(uci -q get network.globals.congestion)"
	mptcp_version="$(uci -q get network.globals.mptcp_version)"
	[ -z "$mptcp_version" ] && mptcp_version="0"
	[ ! -f /proc/sys/net/mptcp/mptcp_enabled ] && mptcp_version="1"
	[ -z "$congestion" ] && congestion="bbr"

	logger -t "OMR" "<$FUNCNAME> mptcp_enabled=${mptcp_enabled} checksum=${checksum} path_manager=${path_manager}" \
	"scheduler=${scheduler} syn_retries=${syn_retries} congestion=${congestion} mptcp_version=${mptcp_version}"

	if [ "$mptcp_enabled_current" != "$mptcp_enabled" ] \
	|| [ "$checksum_current" != "$checksum" ] \
	|| ([ "$path_manager_current" != "" ] && [ "$path_manager_current" != "$path_manager" ]) \
	|| ([ "$scheduler_current" != "" ] && [ "$scheduler_current" != "$scheduler" ]) \
	|| ([ "$syn_retries_current" != "" ] && [ "$syn_retries_current" != "$syn_retries" ]) \
	|| [ "$congestion_control_current" != "$congestion" ] \
	|| [ "$mptcp_version_current" != "$mptcp_version" ]; then
		settings='{"enabled" : "'$mptcp_enabled'", "checksum": "'$checksum'","path_manager": "'$path_manager'","scheduler": "'$scheduler'","syn_retries": "'$syn_retries'","congestion_control": "'$congestion'","version": "'$mptcp_version'"}'
		logger -t "OMR" "<$FUNCNAME> set vps mptcp: ${settings}"
		echo $(_set_json "mptcp" "$settings")
	else
		echo 1
	fi
}

# 设置默认VPN
_set_vpn_vps() {

	[ -z "$vps_config" ] && vps_config=$(_get_json "config?serial=${serial}")
	[ -z "$vps_config" ] && logger -t "OMR" "<$FUNCNAME> vps_config is empty! return now..." && return
	vpn_current="$(echo "$vps_config" | jsonfilter -q -e '@.vpn.current')"
	vpn="$(uci -q get openmptcprouter.settings.vpn)"

	logger -t "OMR" "<$FUNCNAME> vpn:${vpn}"
	
	if [ "$vpn_current" != "$vpn" ]; then
		local settings='{"vpn" : "'$vpn'"}'
		logger -t "OMR" "<$FUNCNAME> set vps vpn change from ${vpn_current} to ${vpn}"
		echo $(_set_json "vpn" "$settings")
	else
		echo 1
	fi
}

