# 获取http token
_get_token() {
	servername=$1
	# uci get openmptcprouter.vps.username
	[ -z "$(uci -q get openmptcprouter.${servername}.username)" ] && logger -t "OMR" "<$FUNCNAME> ${servername}.username is empty! return now..." && return		# uci get openmptcprouter.vps.username
	# uci get openmptcprouter.vps.password
	# [ -z "$(uci -q get openmptcprouter.${servername}.password)" ] && return
	# uci get openmptcprouter.vps.port
	[ -z "$(uci -q get openmptcprouter.${servername}.port)" ] && logger -t "OMR" "<$FUNCNAME> ${servername}.port is empty! return now..." && return
	# uci get openmptcprouter.vps.ip
	[ -z "$(uci -q get openmptcprouter.${servername}.ip)" ] && logger -t "OMR" "<$FUNCNAME> ${servername}.username is ip! return now..." && return
	# uci get openmptcprouter.vps.disabled
	# [ "$(uci -q get openmptcprouter.${servername}.disabled)" = "1" ] && return
	token=""
	# 认证登录
	_login
	if [ -z "$token" ]; then
		reason=""
		test_ping() {
			_ping_server $1
			status=$?
			if $(exit $status); then
				reason="can ping server ${servername} on $1"
			else
				reason="can't ping server ${servername} on $1"
			fi
		}
		config_list_foreach "${servername}" ip test_ping
		# uci -q get openmptcprouter.vps.port
		port="$(uci -q get openmptcprouter.${servername}.port)"
		# 测试后台服务是否存在
		api_test() {
			server="$1"
			resolve="$(resolveip -t 5 $server)"
			valid_ip6=$(valid_subnet6 $server)
			if [ "$resolve" != "$server" ] || [ "$valid_ip6" != "ok" ]; then
				if [ "$(curl -s -k -m 3 https://${server}:${port}/)" = "" ]; then
					reason="$reason, no server API answer on $1"
				else
					reason="$reason, server API answer on $1"
				fi
			else
				if [ "$(curl -s -k -m 3 https://[${server}]:${port}/)" = "" ]; then
					reason="$reason, no server API answer on $1"
				else
					reason="$reason, server API answer on $1"
				fi
			fi
		}
		config_list_foreach "${servername}" ip api_test
		
		# uci -q get openmptcprouter.vps.username
		if [ "$(uci -q get openmptcprouter.${servername}.username)" != "openmptcprouter" ]; then
			reason="$reason, custom username"
		fi
		[ "$(logread | tail -n 3 | grep -c 'vps token')" -lt 3 ] && logger -t "OMR" "<$FUNCNAME> Can't get ${servername} token, try later ($reason)"
		uci -q batch <<-EOF >/dev/null
			set openmptcprouter.${servername}.admin_error=1
		EOF
	else
		uci -q batch <<-EOF >/dev/null
			set openmptcprouter.${servername}.token_error=0
			commit openmptcprouter
		EOF
	fi
	echo "$server:$serverport:$token"
}

token() {
	config_load openmptcprouter
	config_foreach _get_token server
}

# 聚合模式
mode_aggregate() {
	if [ -f /usr/lib/openmptcprouter-vps/mode_aggregate.sh ]; then
		. /usr/lib/openmptcprouter-vps/mode_aggregate.sh
	fi

	# 启动聚合模式
	if type mode_aggregate_handler >/dev/null 2>&1; then
		mode_aggregate_handler
		return
	fi
}

# 负载均衡模式
mode_balance() {
	if [ -f /usr/lib/openmptcprouter-vps/mode_balance.sh ]; then
		. /usr/lib/openmptcprouter-vps/mode_balance.sh
	fi

	# 启动聚合模式
	if type mode_balance_handler >/dev/null 2>&1; then
		mode_balance_handler
		return
	fi
}

# 单卡模式
mode_single() {
	
	logger -t "OMR" "<$FUNCNAME> mode: single"

	# 单卡模式逻辑在单独的文件中实现
	if [ -f /usr/lib/openmptcprouter-vps/mode_single.sh ]; then
		. /usr/lib/openmptcprouter-vps/mode_single.sh
	fi
	
	# 单卡模式入口函数
	if type mode_single_handler >/dev/null 2>&1; then
		mode_single_handler
		return
	fi
}

# 工作模式: 单卡模式 / 聚合模式 / 负载均衡模式
work_mode() {
	local mode="$(uci -q get global.global.mode)"
	logger -t "OMR" "<$FUNCNAME> mode: ${mode}"
	case "$mode" in
		'single')
			mode_single
			;;
		'aggregate')
			mode_aggregate
			;;
		'balance')
			mode_balance
			;;
		*)
			logger -t "OMR" "<$FUNCNAME> unknown mode:${mode}! reset to mode single"
			mode_single
			;;
	esac
}

# 服务入口
start_service() {

	logger -t "OMR" "####################################"
	logger -t "OMR" "<$FUNCNAME>..."
	logger -t "OMR" "####################################"

	# WAN口IP
	wanips=""
	
	# 序列号,使用CPU序列号作为整机序列号
	serial=$(cat /proc/cpuinfo | grep Serial | awk '{print $3}')
	logger -t "OMR" "<$FUNCNAME> serial: ${serial}"
	# 记录序列号到/etc/config/openmptcprouter
	local saved_serial="$(uci -q get openmptcprouter.settings.serial)"
	if [ "$saved_serial" != "$serial" ]; then
		uci -q set openmptcprouter.settings.serial="$serial"
		logger -t "OMR" "<$FUNCNAME> serial changed from ${saved_serial} to ${serial}"
	fi

	# 工作模式管理: 单卡模式 / 聚合模式 / 负载均衡模式
	work_mode

	# 系统启动时自动恢复备份的 overlay 层软件包
	if [ "$(ps w | grep sysupgrade)" = "" ]; then
		logger -t "OMR" "<$FUNCNAME> Restart /etc/init.d/sysupgrade..."
		/etc/init.d/sysupgrade restart
	fi
}

# 服务触发器，当相关服务或配置发生变化时，OpenMPTCPRouter的VPS组件能够适当地响应
service_triggers() {
	# 当如下服务发生reload时, 会自动触发当前服务的reload
	logger -t "OMR" "<$FUNCNAME> restart triggered by openvpn"
	procd_add_reload_trigger openvpn
	# 当工作模式发生变化时, 自动触发当前服务的work_mode, 这一行似乎没有正常工作
	# procd_add_config_trigger "config.change" "global" /etc/init.d/openmptcprouter-vps work_mode

	# 当防火墙配置/etc/config/firewall发生变化时，会调用set_vps_firewall
	# procd_add_config_trigger "config.change" "firewall" /etc/init.d/openmptcprouter-vps set_vps_firewall
