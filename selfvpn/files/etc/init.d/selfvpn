START=90
STOP=10

# 启用procd进程管理
USE_PROCD=1
PROG=/usr/sbin/selfvpn

# selfvpn 读取的配置文件
CONF_FILE="/var/etc/selfvpn.ini"

# 聚合模式使用的策略路由接口与表号, 与 OMR 的 omrvpn/1500 约定保持一致
OMRVPN_IFACE="omrvpn"
OMRVPN_TABLE="1500"

# UCI 配置段中需要写入 ini 的选项
SELFVPN_OPTIONS="sn interface mtu authentication logLevel logFile logSize \
	remoteAddr remotePort bufferCapacity queueCapacity ringCapacity \
	ringTotalCapacity socketSendBuffer socketRecvBuffer"

# 根据 UCI 配置段生成 /var/etc/selfvpn.ini
# 内容没变化时不动文件: procd 通过 ini 的 mtime 判断是否需要重启实例,
# 而实例重启会销毁并重建 tun 设备, 连带清掉主表里指向隧道的默认路由。
generate_ini() {
	local s="$1"
	local key value
	local tmp="${CONF_FILE}.tmp.$$"

	mkdir -p "$(dirname "$CONF_FILE")"
	: > "$tmp"

	for key in $SELFVPN_OPTIONS; do
		config_get value "$s" "$key"
		[ -n "$value" ] && echo "${key}=${value}" >> "$tmp"
	done

	if [ -f "$CONF_FILE" ] && cmp -s "$tmp" "$CONF_FILE"; then
		rm -f "$tmp"
		return 0
	fi

	chmod 0600 "$tmp"
	mv -f "$tmp" "$CONF_FILE"
}

# 将 omrvpn 绑定到 selfvpn 的隧道设备, 让 netifd/omr-tracker 接管主表默认路由
bind_omrvpn() {
	local dev="$1"
	local changed=0

	# 只有 selfvpn 被选为聚合模式的 VPN 时才接管 omrvpn, 避免影响 openvpn/mqvpn
	[ "$(uci -q get openmptcprouter.settings.vpn)" = "selfvpn" ] || return 0
	[ -n "$(uci -q get network.${OMRVPN_IFACE})" ] || return 0
	[ -n "$dev" ] || dev="stun"

	[ "$(uci -q get network.${OMRVPN_IFACE}.device)" = "$dev" ] || {
		uci -q set network.${OMRVPN_IFACE}.device="$dev"
		changed=1
	}
	# selfvpn 自己配置 tun 地址, netifd 不能再用 dhcp
	[ "$(uci -q get network.${OMRVPN_IFACE}.proto)" = "none" ] || {
		uci -q set network.${OMRVPN_IFACE}.proto="none"
		changed=1
	}
	[ "$(uci -q get network.${OMRVPN_IFACE}.ip4table)" = "$OMRVPN_TABLE" ] || {
		uci -q set network.${OMRVPN_IFACE}.ip4table="$OMRVPN_TABLE"
		changed=1
	}
	[ "$(uci -q get network.${OMRVPN_IFACE}.metric)" = "$OMRVPN_TABLE" ] || {
		uci -q set network.${OMRVPN_IFACE}.metric="$OMRVPN_TABLE"
		changed=1
	}

	if [ "$changed" = "1" ]; then
		uci -q commit network
		# 让 netifd 重新读取 network 配置, 否则 ifup 仍使用旧的 device
		/etc/init.d/network reload >/dev/null 2>&1
		ifup "$OMRVPN_IFACE" >/dev/null 2>&1
	elif [ "$(ifstatus "$OMRVPN_IFACE" 2>/dev/null | jsonfilter -q -e '@.up')" != "true" ]; then
		# 只在接口确实没起来时才 ifup: 每次 ifup 都会触发 hotplug 并让 omr-tracker 重载,
		# 而 openmptcprouter-vps 每个周期都会调用一次 selfvpn start。
		ifup "$OMRVPN_IFACE" >/dev/null 2>&1
	fi
}

# 启动 selfvpn 实例
start_selfvpn() {
	local s="$1"
	local dev

	generate_ini "$s"

	config_get dev "$s" interface
	bind_omrvpn "$dev"

	procd_open_instance "$s"
	# 以客户端模式启动，读取生成的 ini 配置
	procd_set_param command "$PROG" -c --conf "$CONF_FILE"
	# 监控配置文件变化
	procd_set_param file "$CONF_FILE"
	# 设置进程优先级为10
	procd_set_param nice 10
	# 设置终止超时为15秒
	procd_set_param term_timeout 15
	# 启用进程重启
	procd_set_param respawn
	# 最短重启间隔：3600秒
	procd_append_param respawn 3600
	# 重启阈值：5次
	procd_append_param respawn 5
	# 重启时间窗口：无限制
	procd_append_param respawn -1
	# 完成实例配置
	procd_close_instance
}

# 主服务启动函数
start_service() {
	# 加载 /etc/config/selfvpn
	config_load 'selfvpn'
	# 遍历所有 selfvpn 配置段启动实例
	config_foreach start_selfvpn 'selfvpn'
}

# 服务触发器
service_triggers() {
	# 当 /etc/config/selfvpn 发生变化时重新加载
	procd_add_reload_trigger selfvpn
}

# 停止服务: 只有 omrvpn 当前绑定在 selfvpn 的隧道设备上时才关闭它
stop_service() {
	local dev

	config_load 'selfvpn'
	config_get dev 'selfvpn' 'interface'
	[ -n "$dev" ] || dev="stun"

	if [ "$(uci -q get network.${OMRVPN_IFACE}.device)" = "$dev" ]; then
		ifdown "$OMRVPN_IFACE" >/dev/null 2>&1
	fi

	rm -f "$CONF_FILE"
}
