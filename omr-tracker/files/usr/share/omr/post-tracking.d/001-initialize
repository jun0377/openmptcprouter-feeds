#!/bin/sh

# 此脚本检查接口上的 MPTCP 状态是否正确，
# 并检查 z8102ax 设备上的调制解调器是否配置正确

# ── VPN 接口特殊处理 ──────────────────────────────────────────────────────────
# omrvpn 和 omr6in4 是 VPN/隧道接口，不参与 MPTCP 多路径，强制关闭其 multipath 功能
[ "$OMR_TRACKER_INTERFACE" = "omrvpn" ] && multipath "$OMR_TRACKER_DEVICE" off >/dev/null 2>&1
[ "$OMR_TRACKER_INTERFACE" = "omr6in4" ] && multipath "$OMR_TRACKER_DEVICE" off >/dev/null 2>&1

# ── MPTCP 路由完整性检查 ──────────────────────────────────────────────────────
# 仅对非 VPN 的普通接口执行，且接口名和设备名均不为空
if [ -n "$OMR_TRACKER_INTERFACE" ] && [ -n "$OMR_TRACKER_DEVICE" ] && [ "$OMR_TRACKER_INTERFACE" != "omrvpn" ] && [ "$OMR_TRACKER_INTERFACE" != "omr6in4" ]; then
	
	# 如果接口在 UCI 中被标记为 disabled，停止对其的追踪并重载 MPTCP
	if [ "$(uci -q get network.$OMR_TRACKER_INTERFACE.disabled)" = "1" ]; then
		_log "Disable MPTCP & Tracker on the disabled interface $OMR_TRACKER_INTERFACE ($OMR_TRACKER_DEVICE)"
		logger -t "OMR" "<omr-tracker ${OMR_TRACKER_INTERFACE} ${OMR_TRACKER_DEVICE}> Disable MPTCP & Tracker on the disabled interface $OMR_TRACKER_INTERFACE ($OMR_TRACKER_DEVICE)"

		/etc/init.d/mptcp reload "$OMR_TRACKER_DEVICE" >/dev/null 2>&1		# 重载 MPTCP，将该设备从多路径中移除
		logger -t "OMR" "<omr-tracker ${OMR_TRACKER_INTERFACE} ${OMR_TRACKER_DEVICE}> /etc/init.d/mptcp reload ${OMR_TRACKER_DEVICE} >/dev/null 2>&1"

		/etc/init.d/omr-tracker restart >/dev/null 2>&1						# 重启 tracker，停止对此接口的探测
		logger -t "OMR" "<omr-tracker ${OMR_TRACKER_INTERFACE} ${OMR_TRACKER_DEVICE}> /etc/init.d/omr-tracker restart >/dev/null 2>&1"

		exit 0
	fi

	# 读取接口的路由 metric 值（每个接口使用独立的路由表，表号即 metric）
	metric="$(uci -q get network.$OMR_TRACKER_INTERFACE.metric)"
	# 检查路由表是否正确配置，满足以下任一条件则认为路由异常需要修复：
	# 1. metric 为空（接口未分配路由表）
	# 2. 接口有 IPv4 地址，但对应路由表（table $metric）中找不到该设备的路由
	# 3. 接口有 IPv6 地址，但对应 IPv6 路由表（table 6${metric}）中找不到该设备的路由
	if [ -z "$metric" ] || { [ -n "$OMR_TRACKER_DEVICE_IP" ] && [ -z "$(ip route show table $metric | grep $OMR_TRACKER_DEVICE)" ]; } || { [ -n "$OMR_TRACKER_DEVICE_IP6" ] && [ -z "$(ip -6 route show table 6${metric} | grep $OMR_TRACKER_DEVICE)" ]; }; then
		_log "Routes not correctly set for $OMR_TRACKER_INTERFACE ($OMR_TRACKER_DEVICE table $metric) with IPs $OMR_TRACKER_DEVICE_IP $OMR_TRACKER_DEVICE_IP6"
		logger -t "OMR" "<omr-tracker ${OMR_TRACKER_INTERFACE} ${OMR_TRACKER_DEVICE}> Routes not correctly set for $OMR_TRACKER_INTERFACE ($OMR_TRACKER_DEVICE table $metric) with IPs $OMR_TRACKER_DEVICE_IP $OMR_TRACKER_DEVICE_IP6"
		
		# 重载 MPTCP 以重建路由规则
		/etc/init.d/mptcp reload "$OMR_TRACKER_DEVICE" >/dev/null 2>&1
		logger -t "OMR" "<omr-tracker ${OMR_TRACKER_INTERFACE} ${OMR_TRACKER_DEVICE}> /etc/init.d/mptcp reload ${OMR_TRACKER_DEVICE} >/dev/null 2>&1"

		# 重启 tracker 以重新初始化接口状态
		_log "Restart OMR-Tracker"
		logger -t "OMR" "<omr-tracker ${OMR_TRACKER_INTERFACE} ${OMR_TRACKER_DEVICE}> Restart OMR-Tracker"
		/etc/init.d/omr-tracker restart >/dev/null 2>&1
		logger -t "OMR" "<omr-tracker ${OMR_TRACKER_INTERFACE} ${OMR_TRACKER_DEVICE}> /etc/init.d/omr-tracker restart >/dev/null 2>&1"
		exit 0
	fi
fi

