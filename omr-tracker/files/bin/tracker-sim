#!/bin/sh

# 单个SIM模组的拨号及状态监控
# 由 /etc/init.d/tracker-sim 通过procd调用，参数为sim名称（如sim1）

. /lib/functions.sh

ifname=$1               # 逻辑网口名, 如sim1 wan1
interface=""            # 物理网口名, 如eth1 usb1
sysfs=""                # sim模组在sysfs中对应的路径
ttyUSB=""               # 拨号节点
VID=""                  # 模组的Vendor ID
PID=""                  # 模组的Product ID

MODEM_MANUFACTURE=""    # 模组厂商
MODEM_MODEL=""          # 模组型号
MODEM_REVISION=""       # 模组版本
MODEM_IMEI=""           # 模组IMEI
MODEM_SN=""             # 模组序列号

SIM_ICCID=""            # SIM卡的ICCID
SIM_IMSI=""             # SIM卡的IMSI
SIM_STATUS=""           # SIM卡状态的字符串描述
SIM_C5GREG=""           # 5G Core 注册状态，即终端在 5G 核心网 的注册状态
SIM_CREG=""             # EPS域注册状态,即LTE注册状态
SIM_FREQ=""             # LTE/NR工作频率查询,当前小区的频率信息
SIM_MONSC=""            # 当前驻留小区信息
SIM_IPv4=""             # 拨号成功后获取到的IPv4地址
SIM_IPv6=""             # 拨号成功后获取到的IPv6地址

DIAL_CID=1              # 拨号使用的PDP上下文索引
DIAL_APN=""             # 拨号使用的APN
DIAL_NET=""             # 入网方式配置: AUTO SA NSA LTE

DIAL_AUTH_TYPE=""       # 鉴权方式: NONE PAP CHAP
DIAL_AUTH_USER=""       # 用户名
DIAL_AUTH_PASSWD=""     # 密码

NR_LOCK_ENABLE=""       # NR锁频/锁小区使能: 0-关闭锁频功能; 1-启用锁定频点功能; 2-启用锁定小区功能; 3-启用锁定Band功能
NR_LOCK_PCID=""         # NR PCID
NR_LOCK_BAND=""         # NR频段
NR_LOCK_FREQ=""         # NR频点
NR_LOCK_SCS=""          # NR子载波间隔
NR_FREQLOCK_JSON="{}"   # JSON格式的NR锁频/锁小区信息

LTE_LOCK_ENABLE=""      # LTE锁频/锁小区使能: 0-关闭锁频功能; 1-启用锁定频点功能; 2-启用锁定小区功能; 3-启用锁定Band功能
LTE_LOCK_PCID=""        # LTE PCID
LTE_LOCK_BAND=""        # LTE频段
LTE_LOCK_FREQ=""        # LTE频点
LTE_FREQLOCK_JSON="{}"  # JSON格式的LTE锁频/锁小区信息

function _log()
{
    logger -t "${ifname}" "<${interface} ${ttyUSB}>" "$@"
    echo "${ifname} <${interface} ${ttyUSB}>" "$@"
}

# 保存到tmpfs
function _save()
{
    local item=$1       # 参数项
    local state=$2      # 参数值

    local statusfs="/tmp/tracker-sim/${ifname}"
    [ -d ${statusfs} ] || mkdir -p ${statusfs}

    echo "${state}" > "${statusfs}/${item}"
}

# 拨号成功, 进行DHCP
function sim_dhcp()
{
    # 检查网口是否存在
    [ -d "/sys/class/net/${interface}" ] || {
        _log "interface ${interface} not exist, skip dhcp"
        return 0
    }

    # 检查网口是否已up
    ifconfig ${interface} up

    # udhcpc最多试2次,间隔1秒,总超时2秒
    local res
    res=$(timeout -k 1 5 udhcpc -i "$interface" -t 5 -T 3 -n -q 2>&1) || {
        _log "dhcp failed or timeout"
        return 0
    }

    printf '%s\n' "$res" | while IFS= read -r line; do
        [ -n "$line" ] && _log "$line"
    done

    local ip="$(echo "$res" | awk '/lease of/ {print $4; exit}')"
    local mask="$(echo "$res" | awk '/ip addr add/ {split($5,a,"/"); print a[2]; exit}')"
    local gw="$(echo "$res" | sed -n 's/.*setting default routers:[[:space:]]*//p' | awk '{print $1; exit}')"
    _log "${ip} mask:${mask} gw:${gw}"
}

# 基本配置检查: 检查uci配置是否正确
function check_base
{
    _save "ifname" "${ifname}"

    # 检查sysfs中是否已有模组对应信息
    config_load sim
    config_get sysfs "$ifname" usb
    [ -z "$sysfs" ] && _log "sysfs is not defined! (uci get sim.$ifname.usb)" && return 1
    [ ! -d "$sysfs" ] && _log "sysfs is not exist! sysfs:${sysfs}" && return 1

    _log "sysfs:${sysfs}"
    _save "sysfs" "${sysfs}"

    # 获取拨号所需的/dev/ttyUSB节点
    config_get ttyUSB "$ifname" ttyUSB
    [ -z "$ttyUSB" ] && _log "ttyUSB is not defined! (uci get sim.$ifname.ttyUSB)" && return 1
    [ ! -d "$sysfs/$ttyUSB" ] && _log "ttyUSB sysfs path is not exist! $sysfs/$ttyUSB" && return 1
    ttyUSB=$(ls "$sysfs/$ttyUSB" | grep ttyUSB)
    [ -z "$ttyUSB" ] && _log "can not find ttyUSB in $sysfs/$ttyUSB" && return 1
    ttyUSB="/dev/${ttyUSB}"

    _save "ttyUSB" "${ttyUSB}"

    # 获取对应的真实物理网口（sysfs下的usb接口目录包含net子目录，其中即为网口名）
    interface=$(ls "$sysfs"/*/net/ 2>/dev/null)
    [ -z "$interface" ] && _log "can not find interface in ${sysfs}" && return 1

    _save "interface" "${interface}"

    # 获取模组的VID:PID
    VID=$(cat /sys/bus/usb/devices/$(basename $sysfs)/idVendor)
    [ -z "$VID" ] && _log "unknown Vendor! " && return 1

    _save "VID" "${VID}"

    PID=$(cat /sys/bus/usb/devices/$(basename $sysfs)/idProduct)
    [ -z "$PID" ] && _log "unknown Product! " && return 1

    _save "PID" "${PID}"

    _log "VID:PID=$VID:$PID"

    return 0
}

# 获取模组基本信息
function get_product_info()
{
    # 获取模组厂商信息和IMEI
    if [ -z "${MODEM_MANUFACTURE}" ] || [ -z "${MODEM_MODEL}" ] || [ -z "${MODEM_REVISION}" ] || [ -z "${MODEM_IMEI}" ]; then
        if atcmd_get_modem_model; then
            _log "${MODEM_MANUFACTURE} ${MODEM_MODEL} ${MODEM_REVISION} ${MODEM_IMEI}"
            _save "manufacture" "${MODEM_MANUFACTURE}"
            _save "model" "${MODEM_MODEL}"
            _save "revision" "${MODEM_REVISION}"
            _save "imei" "${MODEM_IMEI}"
        else
            _log "failed to get modem info"
        fi
    fi

    # 获取模组序列号
    if [ -z ${MODEM_SN} ]; then
        if atcmd_get_modem_sn; then
            _save "sn" "${MODEM_SN}"
        else
            _log "failed to get modem sn"
        fi
    fi
}

# 初始化
function initialize
{
    # 打开回显
    atcmd_init_echo
    # 初始化网卡数量为1
    atcmd_init_netnum
    # 设置USB端口形态配置为Linux NCM模式
    atcmd_init_ncm
    # 开启SIM卡热插拔
    atcmd_init_hotplug

    return 0
}

# 拨号
function dial
{
    # 必须先断开连接才能激活PDP上下文
    atcmd_disconnect

    # 设置APN
    local apn=$(uci -q get sim.$ifname.apn)
    [ -z ${apn} ] && {
        _log "apn required! (uci -q get sim.$ifname.apn)"
        return 1
    }
    atcmd_set_apn $apn

    # 设置入网方式
    local net=$(uci -q get sim.$ifname.net)
    atcmd_set_net $net

    # 设置鉴权
    local auth=$(uci -q get sim.$ifname.auth)
    local user=$(uci -q get sim.$ifname.user)
    local passwd=$(uci -q get sim.$ifname.passwd)
    atcmd_set_auth $auth $user $passwd


    # 锁5G频段/PCI小区
    local nr_lock=$(uci -q get sim.$ifname.nrPciLock)
    local nr_pcid=$(uci -q get sim.$ifname.nrPciPcid)
    local nr_band=$(uci -q get sim.$ifname.nrPciBand)
    local nr_freq=$(uci -q get sim.$ifname.nrPciFreq)
    local nr_scs=$(uci -q get sim.$ifname.nrPciScs)
    atcmd_set_nr_lock $nr_lock $nr_pcid $nr_band $nr_freq $nr_scs

    # 锁LTE频段/PCI小区
    local lte_lock=$(uci -q get sim.$ifname.ltePciLock)
    local lte_pcid=$(uci -q get sim.$ifname.ltePciPcid)
    local lte_band=$(uci -q get sim.$ifname.ltePciBand)
    local lte_freq=$(uci -q get sim.$ifname.ltePciFreq)
    atcmd_set_lte_lock $lte_lock $lte_pcid $lte_band $lte_freq

    # 切换一次飞行模式
    atcmd_set_airplane_on
    sleep 3
    atcmd_set_airplane_off

    # 拨号
    atcmd_connect

    # 拨号成功, 进行DHCP
    sim_dhcp

    return 0
}

# 检查拨号
function check_dial
{
    # 检查是否插卡
    atcmd_get_sim_status_realtime
    _save "sim_status" "${SIM_STATUS}"

    # 判断SIM_STATUS中是否包含: "SIM Initialized" 或 "SIM Ready"
    if ! echo "${SIM_STATUS}" | grep -qE "SIM Initialized|SIM Ready"; then
        _log "SIM not ready! status: ${SIM_STATUS}"
        return 1
    fi

    # 获取iccid
    atcmd_get_iccid
    _save "iccid" "${SIM_ICCID}"

    # 获取imsi
    atcmd_get_imsi
    _save "imsi" "${SIM_IMSI}"

    # 检查是否需要重新拨号
    atcmd_get_addr
    # IPv4
    [ -z "${SIM_IPv4}" ] || { 
        _log "IP: ${SIM_IPv4}" 
        _save "IPv4" "${SIM_IPv4}"
    } 
    [ -z "${SIM_IPv4}" ] && { 
        _log "IPv4 not ready!"
        _save "IPv4" ""
    }
    # IPv6
    [ -z "${SIM_IPv6}" ] || {
        _log "IP: ${SIM_IPv6}"
        _save "IPv6" "${SIM_IPv6}"
    }
    [ -z "${SIM_IPv6}" ] && {
        _log "IPv6 not ready!"
        _save "IPv6" ""
    }

    # 拨号
    dial
}

# 更新实时状态信息
function update_state
{
    # SIM卡状态
    atcmd_get_sim_status_realtime
    # 5G Core注册状态
    atcmd_get_sim_5GCore_realtime
    # EPS域注册状态,即LTE注册状态
    atcmd_get_sim_EREG_realtime
    # LTE/NR工作频率查询,当前小区的频率信息
    atcmd_get_sim_freq_realtime
    # 当前驻留小区信息
    atcmd_get_sim_monsc_realtime
    # 相邻小区信息
    atcmd_get_sim_monnc_realtime
}

# 主循环
function _main()
{
    while true; do

        sleep 5

        # 检查模组是否已经成功识别了,即sysfs中有相应信息
        while true; do
            check_base && break
            sleep 3
        done

        # 根据VID:PID加载模组对应的AT指令脚本
        [ ! -z ${VID} ] && [ ! -z ${PID} ] && {

            ATCMD_FILE=/usr/share/omr/lib/${VID}${PID}.sh
            [ ! -f ${ATCMD_FILE} ] && {
                logger -t "sim" "<$(basename $0) ${ifname} ${interface} ${ttyUSB}> ${ATCMD_FILE} is not exist!"
                continue;
            }

            . ${ATCMD_FILE}
        }

        # 初始化
        initialize

        # 获取模组基本信息
        get_product_info

        # 检查拨号状态
        check_dial

        # 更新实时状态信息
        update_state

    done
}

_main
