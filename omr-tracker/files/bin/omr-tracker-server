#!/bin/bash
# vim: set noexpandtab tabstop=4 shiftwidth=4 softtabstop=4 :

# 此脚本用于探测服务器连通性状态

name=$0
basename="$(basename $0)"

. /usr/lib/unbound/iptools.sh
. /usr/share/libubox/jshn.sh

export OMR_TRACKER_STATUS			# 导出探测状态（OK/ERROR）
export OMR_TRACKER_STATUS_MSG		# 导出状态消息（原因说明）
export OMR_TRACKER_LATENCY			# 导出探测延迟（ms）
export OMR_TRACKER_LOSS				# 导出丢包率（百分比整数）

# logger -t "OMR" "<$basename> $0"

# 后置钩子函数
_post_tracking() {
	[ ! -d /usr/share/omr/server-post-tracking.d/ ] && return		# 若无钩子目录则直接返回
	# 执行钩子脚本
	for tracker_bin in /usr/share/omr/server-post-tracking.d/*; do
		[ -x "$tracker_bin" ] && . "$tracker_bin" 2>&1
	done
}

# 保持探测信息到/tmp/tracker-server/tracker-server.json文件
_save() {

	local latency_val="${OMR_TRACKER_LATENCY:-0}"
	[[ "$latency_val" =~ ^[0-9]+$ ]] || latency_val=0
	local loss_val="${OMR_TRACKER_LOSS:-0}"
	[[ "$loss_val" =~ ^[0-9]+$ ]] || loss_val=0

	[ "$OMR_TRACKER_STATUS" = "OK" ] && OMR_TRACKER_STATUS_MSG="network ready!"

	json_init
	json_add_string status "${OMR_TRACKER_STATUS:-ERROR}"	# 状态
	json_add_string msg "${OMR_TRACKER_STATUS_MSG:-}"		# 错误信息
	
	# 网络正常时才更新如下参数
	[ "$OMR_TRACKER_STATUS" = "OK" ] && {
		json_add_int latency "$latency_val"						# 延时rtt
		json_add_int loss "$loss_val"							# 丢包率
		json_add_string interface "${interface:-}"				# 探测用的逻辑接口名,如wan0
		json_add_string device "$device"						# 探测用的物理接口名,如eth1
	}
	
	json_add_int ts "$(date +%s)"							# 时间戳
	json_add_string timestamp "$(date +"%H:%M:%S")"			# 时间戳,高可读性

	# 探测结果保存目录
	[ ! -d /tmp/tracker-server ] && mkdir -p /tmp/tracker-server

	# 原子保存
	local outfile="/tmp/tracker-server/tracker-server.json"
	local tmpfile="/tmp/tracker-server/.tracker-server.json.$$"
	json_dump > "$tmpfile" && mv "$tmpfile" "$outfile" || rm -f "$tmpfile"
}

# 聚合模式下使用multipath命令返回的interface进行测试
_ping_server_intf_in_mode_aggregate() {
	local host=$1

	# 遍历具备默认路径的接口
	for intf in $(multipath 2>/dev/null | awk '/default/ {print $1}'); do
		local k=0
		# 重试至上限
		while [ "$k" -le "$retry" ]; do
			# 绑定指定接口ping服务器
			ret=$(ping -w "$OMR_TRACKER_TIMEOUT" -c 1 -q -I "$intf" "${host}" 2>&1)
			# 丢包率
			loss=$(echo "$ret" | awk '/packet loss/ {gsub("%","");print $6}' | tr -d '\n')
			# 丢包率不是100%, 则认为服务器可达
			if [ -n "$loss" ] && [ "$loss" != "100" ]; then
				latency=$(echo "$ret" | awk -F/ '/rtt/ {print int($5)}' | tr -d '\n')
				[ -n "$latency" ] && OMR_TRACKER_LATENCY="$latency"
				OMR_TRACKER_STATUS="OK"
				OMR_TRACKER_LOSS="$loss"
			
				break
			fi

			# 丢包率100%
			if [ -z "$loss" ] || [ "$loss" = "100" ]; then
				OMR_TRACKER_STATUS="ERROR"
				OMR_TRACKER_STATUS_MSG="${host} unreachable!"
			fi

			# 次数+1
			k=$((k+1))
			# 重试间隔
			sleep "${intervaltries}"
		done
	done

	# 保存状态
	_save
}

# 单卡模式下检查管理平台连通性
_ping_server_intf_in_mode_single()
{
	local host=$1
	local interface=$(uci -q get global.single.channel)
	local device=$(ubus call network.interface.${interface} status | jsonfilter -e '@.device')
	[ -z "${device}" ] && device=$(ubus call network.interface.${interface} status | jsonfilter -e '@.l3_device')
	[ -z "${device}" ] && logger -t "OMR" "<$basename> unknown interface: ${interface}-${device}"

	local k=0
	while [ "$k" -le "$retry" ]; do
		# 绑定指定接口ping服务器
		ret=$(ping -w "$OMR_TRACKER_TIMEOUT" -c 1 -q -I "${device}" "${host}" 2>&1)
		# 丢包率
		loss=$(echo "$ret" | awk '/packet loss/ {gsub("%","");print $6}' | tr -d '\n')
		# 丢包率不是100%, 则认为服务器可达
		if [ -n "$loss" ] && [ "$loss" != "100" ]; then
			
			OMR_TRACKER_STATUS="OK"

			# RTT
			latency=$(echo "$ret" | awk -F/ '/rtt/ {print int($5)}' | tr -d '\n')
			[ -n "$latency" ] && OMR_TRACKER_LATENCY="$latency"
			OMR_TRACKER_LOSS="$loss"

			break
		fi

		# 次数+1
		k=$((k+1))
		# 重试间隔
		sleep "${intervaltries}"
	done

	[ "$OMR_TRACKER_STATUS" != "OK" ] && OMR_TRACKER_STATUS_MSG="${host} unreachable!" && logger -t "OMR" "<$basename> ${host} unreachable !"
	[ "$OMR_TRACKER_STATUS" = "OK" ] && logger -t "OMR" "<$basename> server:${host} local:${device} rtt:${OMR_TRACKER_LATENCY}ms loss:${OMR_TRACKER_LOSS}% "

	_save
}

# 负载均衡模式下检查管理平台连通性
_ping_server_intf_in_mode_balance()
{
	local host=$1
	local k=0
	while [ "$k" -le "$retry" ]; do
		# 绑定指定接口ping服务器
		ret=$(ping -w "$OMR_TRACKER_TIMEOUT" -c 1 -q "${host}" 2>&1)
		# 丢包率
		loss=$(echo "$ret" | awk '/packet loss/ {gsub("%","");print $6}' | tr -d '\n')
		# 丢包率不是100%, 则认为服务器可达
		if [ -n "$loss" ] && [ "$loss" != "100" ]; then
			
			OMR_TRACKER_STATUS="OK"

			# RTT
			latency=$(echo "$ret" | awk -F/ '/rtt/ {print int($5)}' | tr -d '\n')
			[ -n "$latency" ] && OMR_TRACKER_LATENCY="$latency"
			OMR_TRACKER_LOSS="$loss"

			break
		fi

		# 次数+1
		k=$((k+1))
		# 重试间隔
		sleep "${intervaltries}"
	done

	[ "$OMR_TRACKER_STATUS" != "OK" ] && OMR_TRACKER_STATUS_MSG="${host} unreachable!" && logger -t "OMR" "<$basename> ${host} unreachable !"
	[ "$OMR_TRACKER_STATUS" = "OK" ] && logger -t "OMR" "<$basename> server:${host} local:${device} rtt:${OMR_TRACKER_LATENCY}ms loss:${OMR_TRACKER_LOSS}% "

	_save
}

# 不同工作模式下使用不同的接口进行检测
_ping_server_intf()
{
	local work_mode=$(uci -q get global.global.mode)
	case ${work_mode} in
		"single")
			_ping_server_intf_in_mode_single "$@"
			;;
		"aggregate")
			_ping_server_intf_in_mode_aggregate "$@"
			;;
		"balance")
			_ping_server_intf_in_mode_balance "$@"
			;;
		*)
			logger -t "OMR" "<$basename> unknown work mode!"
			;;
	esac
}

# 聚合模式下逐接口探测VPS的API
_check_server_api_in_mode_aggregate() {
	local host=$1
	local valid_ip6=$(valid_subnet6 "$host")
	for intf in $(multipath 2>/dev/null | awk '/default/ {print $1}'); do
		local k=0
		while [ "$k" -le "$retry" ]; do
			if [ "$valid_ip6" != "ok" ]; then
				ret=$(curl --max-time "$OMR_TRACKER_TIMEOUT" -s -k --interface "$intf" "https://${host}:${port}/")
			else
				ret=$(curl --max-time "$OMR_TRACKER_TIMEOUT" -s -k "https://[${host}%${intf}]:${port}/")
			fi

			[ -n "$ret" ] && break

			k=$((k+1))
			sleep "${intervaltries}"
		done
	done

	[ -z "$ret" ] && {
		OMR_TRACKER_STATUS="ERROR"
		OMR_TRACKER_STATUS_MSG="${host} API test failed!"
	}
	[ -n "$ret" ] && {
		OMR_TRACKER_STATUS="OK"
	}

	# 保存状态
	_save
}

# 单卡模式下进行API检测
_check_server_api_in_mode_single()
{
	[ "single" =  "$(uci -q get global.global.mode)" ] || logger -t "OMR" "<$basename> not single mode! mode:$(uci -q get global.global.mode)"

	local host=$1
	local valid_ip6=$(valid_subnet6 "$host")
	local interface=$(uci -q get global.single.channel)
	local device=$(ubus call network.interface.${interface} status | jsonfilter -e '@.device')
	[ -z "${device}" ] && device=$(ubus call network.interface.${interface} status | jsonfilter -e '@.l3_device')
	[ -z "${device}" ] && logger -t "OMR" "<$basename> unknown interface: ${interface}-${device}"

	local k=0
	while [ "$k" -le "$retry" ]; do
		if [ "$valid_ip6" != "ok" ]; then
			ret=$(curl --max-time "$OMR_TRACKER_TIMEOUT" -s -k --interface "$device" "https://${host}:${port}/")
		else
			ret=$(curl --max-time "$OMR_TRACKER_TIMEOUT" -s -k "https://[${host}%${device}]:${port}/")
		fi

		[ -n "$ret" ] && break

		k=$((k+1))
		sleep "${intervaltries}"
	done

	[ -z "$ret" ] && {
		OMR_TRACKER_STATUS="ERROR"
		OMR_TRACKER_STATUS_MSG="${host} API test failed!"
	}
	[ -n "$ret" ] && OMR_TRACKER_STATUS="OK"

	# 保存状态
	_save
}

# 负载均衡模式下进行API检测
_check_server_api_in_mode_balance()
{
	[ "balance" =  "$(uci -q get global.global.mode)" ] || logger -t "OMR" "<$basename> not balance mode! mode:$(uci -q get global.global.mode)"

	local host=$1
	local valid_ip6=$(valid_subnet6 "$host")

	local k=0
	while [ "$k" -le "$retry" ]; do
		if [ "$valid_ip6" != "ok" ]; then
			ret=$(curl --max-time "$OMR_TRACKER_TIMEOUT" -s -k "https://${host}:${port}/")
		else
			ret=$(curl --max-time "$OMR_TRACKER_TIMEOUT" -s -k "https://[${host}%${device}]:${port}/")
		fi

		[ -n "$ret" ] && break

		k=$((k+1))
		sleep "${intervaltries}"
	done

	[ -z "$ret" ] && {
		OMR_TRACKER_STATUS="ERROR"
		OMR_TRACKER_STATUS_MSG="${host} API test failed!"
	}
	[ -n "$ret" ] && OMR_TRACKER_STATUS="OK"

	# 保存状态
	_save
}

# 不同工作模式下使用不同的接口进行API检测
_check_server_api()
{
	local work_mode=$(uci -q get global.global.mode)
	case ${work_mode} in
		"single")
			_check_server_api_in_mode_single "$@"
			;;
		"aggregate")
			_check_server_api_in_mode_aggregate "$@"
			;;
		"balance")
			_check_server_api_in_mode_balance "$@"
			;;
		*)
			logger -t "OMR" "<$basename> unknown work mode!"
			;;
	esac
}

# 服务器API测试和ping测试
_check_server() {
	local name=$1
	config_get master $1 master
	config_get ip $1 ip
	config_get port $1 port
	serverip=""

	# logger -t "OMR" "<$basename> master:${master} ip:${ip} port:${port}"

	# 针对每个 IP/域名条目进行探测
	check_ip() {
		local ipd=$1

		# 解析 IPv4, resolveip 可以在一定程度上进行IP格式校验
		ipresolve="$(resolveip -t 5 -4 $ipd | head -n 1)"
		[ -n "$ipresolve" ] && serverip="$ipresolve"
		# 解析 IPv6
		ip6resolve="$(resolveip -t 5 -6 $ipd | head -n 1)"
		[ -n "$ip6resolve" ] && serverip="$ip6resolve"
		
		# IP解析失败
		[ -z "$serverip" ] && logger -t "OMR" "<$basename> unknown vps ip!" && return

		# ping测试（判断网络连通性）
		_ping_server_intf $serverip
		# 网络连通后, 才进行API测试
		[ "$OMR_TRACKER_STATUS" = "OK" ] && _check_server_api $serverip $port
	}

	# uci配置文件中的服务器ip是一个list, 逐个进行判断
	config_load openmptcprouter
	config_list_foreach $1 ip check_ip

	return
	
}

# 引入 UCI/配置工具函数
. /lib/functions.sh

timeout=${OMR_TRACKER_TIMEOUT:-5}					# 探测超时（默认 5s）
interval=${OMR_TRACKER_INTERVAL:-10}				# 主循环间隔（默认 10s）
intervaltries=${OMR_TRACKER_INTERVAL_TRIES:-2}		# 重试间隔（默认 2s）
retry=${OMR_TRACKER_TRIES:-4}						# 每项重试次数（默认 4）
waittest=${OMR_TRACKER_WAIT_TEST:-0}				# 切换后等待（默认 0）

# 主循环：优先检测master服务器，再检查备用服务器(实际上,只有一个master服务器)
# 将检查结果保存到文件/tmp/${interface}-tracker-server.json
while true; do

	config_load openmptcprouter
	config_foreach _check_server server

	sleep "${interval}"
done
