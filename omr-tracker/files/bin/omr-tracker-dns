#!/bin/bash
# vim: set noexpandtab tabstop=4 shiftwidth=4 softtabstop=4 :

# 此脚本用于检测DNS服务状态

name=$0
basename="$(basename $0)"

. /usr/share/libubox/jshn.sh

export OMR_TRACKER_DNS_RUNNING      # 进程是否存在
export OMR_TRACKER_DNS_RESOLVED     # dns解析是否成功
export OMR_TRACKER_DNS_RESOLVER     # 使用的是unbound还是dnsmasq
export OMR_TRACKER_DNS_QUERY        # 测试的是哪个域名
export OMR_TRACKER_DNS_ANSWER       # 域名解析结构
export OMR_TRACKER_DNS_MSG          # 状态信息

interval="${OMR_TRACKER_INTERVAL:-15}"

# DNS 自愈参数: 连续失败达到阈值后清理缓存并重启相关服务, 冷却期内不重复动作
RECOVER_THRESHOLD=2			# 连续失败轮数(约 30 秒)
RECOVER_COOLDOWN=300		# 两次自愈动作的最小间隔(秒)
dns_fail_count=0
last_recover_ts=0

# 保持探测信息到/tmp/tracker-dns/tracker-dns.json文件
_save() {
	json_init
	json_add_boolean running "${OMR_TRACKER_DNS_RUNNING:-0}"
	json_add_boolean resolved "${OMR_TRACKER_DNS_RESOLVED:-0}"
	json_add_string resolver "${OMR_TRACKER_DNS_RESOLVER:-}"
	json_add_string query "${OMR_TRACKER_DNS_QUERY:-openwrt.org}"
	json_add_string answer "${OMR_TRACKER_DNS_ANSWER:-}"
	json_add_string updated "$(date +"%Y-%m-%d %H:%M:%S")"
	json_add_string msg "${OMR_TRACKER_DNS_MSG:-DNS service not running}"
	json_add_int ts "$(date +%s)"
	json_add_string timestamp "$(date +"%H:%M:%S")"

	[ ! -d /tmp/tracker-dns ] && mkdir -p /tmp/tracker-dns

	local outfile="/tmp/tracker-dns/tracker-dns.json"
	local tmpfile="/tmp/tracker-dns/.tracker-dns.json.$$"
	json_dump > "$tmpfile" && mv "$tmpfile" "$outfile" || rm -f "$tmpfile"
}

# 检查unbound和dnsmasq进程是否存在
_check_dns_pid() {
	local unbound_pid dnsmasq_pid

	unbound_pid="$(pgrep -f '/usr/sbin/unbound' 2>/dev/null | head -n 1)"
	dnsmasq_pid="$(pgrep -f '/usr/sbin/dnsmasq' 2>/dev/null | head -n 1)"

    logger -t "OMR" "<$basename> unbound pid:${unbound_pid} dnsmasq pid:${dnsmasq_pid}"

	if [ -n "$unbound_pid" ]; then
		OMR_TRACKER_DNS_RUNNING=1
		OMR_TRACKER_DNS_RESOLVER="unbound"
        logger -t "OMR" "<$basename> unbound is running..."
		return 0
	fi

	if [ -n "$dnsmasq_pid" ]; then
		OMR_TRACKER_DNS_RUNNING=1
		OMR_TRACKER_DNS_RESOLVER="dnsmasq"
        logger -t "OMR" "<$basename> dnsmasq is running..."
		return 0
	fi

	OMR_TRACKER_DNS_RUNNING=0
	OMR_TRACKER_DNS_RESOLVER=""
	OMR_TRACKER_DNS_MSG="DNS service not running"
	return 1
}

# 域名解析测试
_dig_test() {
	local domains domain answer

	OMR_TRACKER_DNS_RESOLVED=0
	OMR_TRACKER_DNS_QUERY="openwrt.org"
	OMR_TRACKER_DNS_ANSWER=""
	OMR_TRACKER_DNS_MSG="DNS resolution failed"
	domains="www.baidu.com www.taobao.com www.qq.com www.aliyun.com www.google.com"

	for domain in $domains; do
		if command -v dig >/dev/null 2>&1; then
			# 显式查询 127.0.0.1, 不依赖可能为空的 /etc/resolv.conf; 跳过 +short 输出里的 CNAME 行
			answer="$(dig @127.0.0.1 +timeout=2 +tries=1 +short "$domain" 2>/dev/null | grep -v '\.$' | head -n 1 | tr -d '\r\n')"
		else
			answer="$(resolveip -t 2 "$domain" 2>/dev/null | head -n 1 | tr -d '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
		fi
		if [ -n "$answer" ]; then
			OMR_TRACKER_DNS_RESOLVED=1
			OMR_TRACKER_DNS_QUERY="$domain"
			OMR_TRACKER_DNS_ANSWER="$answer"
			OMR_TRACKER_DNS_MSG="DNS resolved successfully"

            logger -t "OMR" "<$basename> resolveip $domain succeess"
			return 0
		fi
	done

    logger -t "OMR" "<$basename> [Failed!] resolveip $domains, but all failed!"
	return 1
}

# 自愈: 先清 unbound 缓存并重启 dnsmasq(清掉两级的负缓存), 仍失败再重启 unbound
# 过程按冷却时间限流, 避免每个探测周期都重启服务
_recover_dns() {
	local now

	now="$(date +%s)"
	[ $((now - last_recover_ts)) -lt "$RECOVER_COOLDOWN" ] && return 0

	logger -t "OMR" "<$basename> DNS failed ${dns_fail_count} times, recovering..."

	if command -v unbound-control >/dev/null 2>&1; then
		unbound-control -c /var/lib/unbound/unbound.conf flush_zone . >/dev/null 2>&1
		unbound-control -c /var/lib/unbound/unbound.conf flush_infra all >/dev/null 2>&1
		logger -t "OMR" "<$basename> flush unbound cache"
	fi
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
	logger -t "OMR" "<$basename> restart dnsmasq"

	# 清缓存后仍不能解析, 说明 unbound 状态已损坏, 直接重启它
	sleep 3
	if _dig_test; then
		logger -t "OMR" "<$basename> DNS recovered"
	else
		/etc/init.d/unbound restart >/dev/null 2>&1
		logger -t "OMR" "<$basename> still failed, restart unbound"
	fi

	last_recover_ts="$now"
	return 0
}

# 主循环
while true; do

	OMR_TRACKER_DNS_RUNNING=0
	OMR_TRACKER_DNS_RESOLVED=0
	OMR_TRACKER_DNS_RESOLVER=""
	OMR_TRACKER_DNS_QUERY="www.baidu.com"
	OMR_TRACKER_DNS_ANSWER=""
	OMR_TRACKER_DNS_MSG="DNS service not running"

	# 只在解析器进程存在时才自愈: 进程整体挂掉由 omr-schedule 负责拉起
	if _check_dns_pid; then
		if _dig_test; then
			dns_fail_count=0
		else
			dns_fail_count=$((dns_fail_count + 1))
			if [ "$dns_fail_count" -ge "$RECOVER_THRESHOLD" ]; then
				_recover_dns
				dns_fail_count=0
			fi
		fi
	fi

	_save

	sleep "$interval"
done
