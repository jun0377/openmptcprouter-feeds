#!/bin/sh

# 作为OpenWrt热插拔iface钩子脚本，在网口状态变化时联动MPTCP配置
## 接口上线/更新时，按接口配置是否开启 multipath 来触发 MPTCP 的配置重载
## 接口下线时，关闭该设备的 MPTCP multipath

[ "$ACTION" = ifup -o "$ACTION" = ifupdate -o "$ACTION" = ifdown -o "$ACTION" = iflink -o "$ACTION" = link-up -o "$ACTION" = link-down ] || exit 0
#[ "$ACTION" = ifupdate -a -z "$IFUPDATE_ADDRESSES" -a -z "$IFUPDATE_DATA" ] && exit 0


/etc/init.d/mptcp enabled || exit 0


# 接口 down 时 netifd 可能不再携带 DEVICE(no_device=1 类协议, 如 sim 的 ncm: teardown 时
# 已把设备交还 netifd), 此时需按接口名反查物理网口, 否则 multipath 会静默失败, MPTCP 路径残留
resolve_device() {
	local iface="$1" dev="" sysfs=""

	[ -n "$iface" ] || return 1

	# 1) tracker-sim 写入的实时状态(含 device 字段)
	if [ -f "/tmp/tracker-sim/$iface/realtime_net_status" ]; then
		dev=$(jsonfilter -q -e '@.device' < "/tmp/tracker-sim/$iface/realtime_net_status" 2>/dev/null | tr -d '\n')
	fi
	# 2) sim 配置里的 sysfs 路径, 取其下的 net 目录
	[ -z "$dev" ] && {
		sysfs=$(uci -q get "sim.$iface.usb")
		[ -n "$sysfs" ] && [ -d "$sysfs" ] && dev=$(ls "$sysfs"/*/net/ 2>/dev/null | head -n 1)
	}
	# 3) ifstatus 中残留的设备名
	[ -z "$dev" ] && dev=$(ifstatus "$iface" 2>/dev/null | jsonfilter -q -e '@["l3_device"]' | tr -d '\n')
	[ -z "$dev" ] && dev=$(ifstatus "$iface" 2>/dev/null | jsonfilter -q -e '@.device' | tr -d '\n')

	[ -n "$dev" ] && { echo "$dev"; return 0; }
	return 1
}


if [ "$ACTION" = ifup -o "$ACTION" = ifupdate -o "$ACTION" = iflink  -o "$ACTION" = link-up ] && [ -z "$(echo $DEVICE | grep oip | grep gre)" ] && [ -n "$(uci -q get network.$INTERFACE.multipath)" ] && [ "$(uci -q get network.$INTERFACE.multipath)" != "off" ]; then
	logger -t "mptcp" "Reloading mptcp config due to $ACTION of $INTERFACE ($DEVICE)"
	/etc/init.d/mptcp reload "$DEVICE" >/dev/null || exit 0
elif [ "$ACTION" = ifdown -o "$ACTION" = link-down ]; then
	# down 事件里 DEVICE 可能为空, 按接口名兜底解析出物理网口
	[ -z "$DEVICE" ] && DEVICE=$(resolve_device "$INTERFACE")
	if [ -n "$DEVICE" ]; then
		multipath $DEVICE off >/dev/null 2>&1 || logger -t "mptcp" "multipath $DEVICE off failed ($ACTION of $INTERFACE)"
	else
		logger -t "mptcp" "can not resolve device of $INTERFACE on $ACTION, MPTCP path may remain"
	fi
fi

